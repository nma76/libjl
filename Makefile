CC := gcc
LD := ld

CFLAGS := -Wall -Iinclude

#
# ----------------------------------------------------------------------
# Library
# ----------------------------------------------------------------------
#

LIB_SRC := $(wildcard src/lib/*.S)
LIB_OBJ := $(patsubst src/lib/%.S,obj/lib_%.o,$(LIB_SRC))

LIBRARY := libjl.a

#
# ----------------------------------------------------------------------
# Applications
# ----------------------------------------------------------------------
#

APP_DIRS := $(wildcard src/apps/*)
APP_NAMES := $(notdir $(APP_DIRS))
APP_BINS := $(addprefix bin/,$(APP_NAMES))

#
# ----------------------------------------------------------------------
# Tests
# ----------------------------------------------------------------------
#

TEST_SRC := $(wildcard tests/*.c)
TEST_BIN := bin/tests

#
# ----------------------------------------------------------------------
# Default targets
# ----------------------------------------------------------------------
#

.PHONY: all clean tests apps

all: $(LIBRARY) tests apps

tests: $(TEST_BIN)

apps: $(APP_BINS)

#
# ----------------------------------------------------------------------
# Library
# ----------------------------------------------------------------------
#

$(LIBRARY): $(LIB_OBJ)
	ar rcs $@ $^

obj/lib_%.o: src/lib/%.S
	@mkdir -p obj
	$(CC) -c $< -o $@

#
# ----------------------------------------------------------------------
# Test runner
# ----------------------------------------------------------------------
#

$(TEST_BIN): $(TEST_SRC) $(LIBRARY)
	@mkdir -p bin
	$(CC) $(CFLAGS) $^ -L. -ljl -o $@

#
# ----------------------------------------------------------------------
# Applications
# ----------------------------------------------------------------------
#

define BUILD_APP

APP_$(1)_SRC := $(wildcard src/apps/$(1)/*.S)
APP_$(1)_OBJ := $$(patsubst src/apps/$(1)/%.S,obj/$(1)_%.o,$$(APP_$(1)_SRC))

$$(APP_$(1)_OBJ): obj/$(1)_%.o: src/apps/$(1)/%.S
	@mkdir -p obj
	$$(CC) -Isrc/apps/$(1) -c $$< -o $$@

bin/$(1): $$(APP_$(1)_OBJ) $(LIBRARY)
	@mkdir -p bin
	$$(LD) $$^ -o $$@

endef

$(foreach app,$(APP_NAMES),$(eval $(call BUILD_APP,$(app))))

#
# ----------------------------------------------------------------------
# Cleanup
# ----------------------------------------------------------------------
#

clean:
	rm -rf obj
	rm -rf bin
	rm -f $(LIBRARY)